# Environment variables - TEMPLATE ONLY. Copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real secrets.
# This file is committed, so it must contain no real credentials - only names
# and descriptions. A future mistake (pasting a live key here) is exactly the
# kind of thing that is unrecoverable once pushed, even to a private repo.
#
# Every variable the application actually reads is listed below. There is no
# aspirational section: an earlier version of this file advertised DATABASE_URL,
# SUPABASE_* and REDIS_URL, none of which any code read. Setting one of those and
# believing it changed behaviour is worse than not having it here at all, so they
# are gone rather than documented as "future". See ADR-0006 (why PGlite) and
# ADR-0007 (why the relay is a single process).

# ------------------------------ Runtime ------------------------------
NODE_ENV=development
PORT=3001

# Interface to bind. 127.0.0.1 is the right default on a laptop and the WRONG one
# in a container: inside a container the interface is a network namespace, and a
# server bound to loopback is unreachable from outside it. Set this to 0.0.0.0 in
# any container or deployed instance, or the health check will fail and nothing
# will explain why.
HOST=127.0.0.1

# ------------------------------ Database ------------------------------
# PGlite persists to a directory, so this is a PATH and not a connection string.
#
# In a container it must be a mounted volume. Without one, every redeploy starts
# from an empty database and every document is gone, which looks exactly like data
# loss and is not.
PGLITE_DATA_DIR=./.data/pgdata

# ------------------------------ Client bundle ------------------------------
# Where the built client lives. Relative paths resolve from the process working
# directory, so this must be right for wherever the server is started, not for
# wherever the repository happens to be checked out.
CLIENT_DIST=./dist/client

# ------------------------------ Security headers ------------------------------
# enforce | report-only. Controls the Content-Security-Policy on static responses.
#
# `enforce` is the default and the shipped setting: the policy produces zero violations
# across all six browser scenarios, verified in CI. `report-only` sends the same policy
# under the -Report-Only header, so the browser logs violations without refusing the
# load. Use it while changing the policy, not as a permanent setting - it reports and
# protects nothing.
#
# Anything else, including a typo, falls back to `enforce` rather than `report-only`: a
# mistyped variable should not silently leave a deployment unprotected.
#
# HSTS is deliberately absent. It belongs to the TLS-terminating proxy, not here; see
# docs/deploy.md.
CSP_MODE=enforce

# ------------------------------ Auth ------------------------------
# JWT_SECRET signs session tokens. Generate with: openssl rand -base64 48
#
# Unset means OPEN AUTH: any well-formed token is accepted and its own text becomes
# the caller's identity. Fine for `npm run dev`, and refused outright when
# NODE_ENV=production, which will not start without a secret.
#
# Minimum 32 bytes; a shorter value is a startup error rather than a weak key.
JWT_SECRET=

# Session lifetime in milliseconds. Optional.
# JWT_TTL_MS=604800000

# AUTH_MODE pins the decision instead of inferring it from JWT_SECRET.
#   required  refuse to start without JWT_SECRET
#   open      refuse to start when NODE_ENV=production
# Unset: use a secret if there is one, otherwise open (outside production).
# AUTH_MODE=required

# ------------------------------ Observability ------------------------------
# Logs are JSON lines on stdout. Every line is JSON, including the last, so a parser
# never has to cope with a stray human-readable warning in the middle of a stream.
#   debug | info | warn | error   (default: info)
LOG_LEVEL=info

# Metrics are served at /api/metrics in Prometheus text format. No external collector
# and no configuration: curl the endpoint, or point a scraper at it. Unauthenticated,
# because a scraper has no session. It exposes counters, never document content.

# ------------------------------ Load testing ------------------------------
# k6 configuration. Driven by `npm run load:*`, which sets these itself.
#
# Deliberately prefixed LOAD_, NOT K6_. `K6_*` is k6's OWN configuration namespace:
# setting K6_DURATION overrode the scenario's own duration and produced a run of the
# wrong length that still exited 0. Same reason this section looks small - the
# harness passes every value explicitly, and these exist so a scenario can be run
# by hand. See scripts/load/README.md for the rest of the k6 traps.
LOAD_BASE_URL=http://127.0.0.1:3001
LOAD_VUS=100
LOAD_DURATION=30s
LOAD_DOCUMENT_ID=manual
