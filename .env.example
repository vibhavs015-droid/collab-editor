# Environment variables — TEMPLATE ONLY. Copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real secrets.
# This file is committed, so it must contain no real credentials — only names
# and descriptions. A future mistake (pasting a live key here) is exactly the
# kind of thing that is unrecoverable once pushed, even to a private repo.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# ── Phase 1/5: database (Supabase free tier) ─────────────────────────────
# Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=
# Supabase: Project Settings -> API
SUPABASE_URL=
# anon/public key — safe to ship to the browser
SUPABASE_ANON_KEY=
# service_role key — SERVER ONLY. Never expose to client code.
SUPABASE_SERVICE_ROLE_KEY=

# ── Phase 5: auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Phase 5: cache / pubsub (optional) ───────────────────────────────────
REDIS_URL=

# ── Phase 5: observability ───────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=collab-editor

# ── Phase 5: load testing (k6) ───────────────────────────────────────────
K6_BASE_URL=http://127.0.0.1:3001
K6_VUS=100
K6_DURATION=30s
