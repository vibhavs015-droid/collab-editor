{
  "name": "collab-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first collaborative editor — sequence CRDT (RGA) with real-time WebSocket sync",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "start": "tsx src/server/index.ts",
    "serve": "node dist/server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "10.0.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/language": "6.11.0",
    "@codemirror/search": "6.5.10",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.1",
    "@electric-sql/pglite": "0.5.8",
    "codemirror": "6.0.2"
  }
}
