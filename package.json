{
  "name": "collab-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first collaborative editor — sequence CRDT (RGA) with real-time WebSocket sync",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "tsx src/server/index.ts",
    "serve": "node dist/server/index.js",
    "smoke": "node scripts/smoke.mjs",
    "start:local": "node scripts/start-local.mjs",
    "start:local:build": "npm run build && node scripts/start-local.mjs",
    "verify:all": "npm run verify && npm run verify:built",
    "preview": "vite preview",
    "test": "vitest run",
    "load": "node scripts/load/run.mjs",
    "load:connect": "node scripts/load/run.mjs connect",
    "load:edit": "node scripts/load/run.mjs edit",
    "load:reconnect": "node scripts/load/run.mjs reconnect",
    "load:divergence": "node scripts/load/run.mjs divergence",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json",
    "check:line-endings": "node scripts/check-line-endings.mjs",
    "check:ignore": "node scripts/check-ignore.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:line-endings && npm run check:ignore && npm test",
    "verify:built": "npm run build && npm run smoke",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "10.0.5",
    "eslint": "^10.12.0",
    "fake-indexeddb": "6.2.2",
    "jsdom": "25.0.1",
    "prettier": "^3.9.9",
    "tsx": "4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/language": "6.11.0",
    "@codemirror/search": "6.5.10",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.1",
    "@electric-sql/pglite": "0.5.8",
    "codemirror": "6.0.2",
    "jose": "^6.2.12",
    "ws": "8.22.0"
  }
}
